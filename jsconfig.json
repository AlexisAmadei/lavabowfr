{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/components/*": ["./src/components/*"],
            "@/hooks/*": ["./src/hooks/*"],
            "@/styles/*": ["./src/styles/*"],
            "@/assets/*": ["./src/assets/*"]
        }
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "dist",
        "**/dist/*"
    ]
}