{
  "compilerOptions": {
    "allowJs": false,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "incremental": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Path aliases */
    "paths": {
      "@/components/*": [
        "./app/_components/*"
      ],
      "@/hooks/*": [
        "./app/_hooks/*"
      ],
      "@/contexts/*": [
        "./app/_contexts/*"
      ],
      "@/utils/*": [
        "./app/_utils/*"
      ],
      "@/lib/*": [
        "./app/_lib/*"
      ],
      "@/types/*": [
        "./app/_types/*"
      ],
      "@/i18n/*": [
        "./app/_i18n/*"
      ],
      "@/styles/*": [
        "./app/_styles/*"
      ],
      "@/assets/*": [
        "./app/_assets/*"
      ],
      "@/features/*": [
        "./app/_features/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app",
    "api",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
